<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Lumine.App.LumineProductStyles">

  <!--
    Lumine product controls are intentionally quiet at rest.
    Content should dominate; controls gain contrast only for interaction,
    selection and commitment.
  -->
  <Style Selector="Button.lumine-control">
    <Setter Property="MinHeight" Value="{DynamicResource Lumine.ControlHeight}" />
    <Setter Property="Padding" Value="{DynamicResource Lumine.ControlPadding}" />
    <Setter Property="FontSize" Value="{DynamicResource Lumine.CaptionFontSize}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Lumine.ControlRadius}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.lumine-primary">
    <Setter Property="Background" Value="{DynamicResource Lumine.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Lumine.PrimaryForeground}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.lumine-primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource Lumine.Selection}" />
  </Style>
  <Style Selector="Button.lumine-primary:pressed">
    <Setter Property="Background" Value="{DynamicResource Lumine.PrimaryPressed}" />
  </Style>
  <Style Selector="Button.lumine-primary:disabled">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionDisabled}" />
    <Setter Property="Foreground" Value="{DynamicResource Lumine.MutedForeground}" />
  </Style>

  <Style Selector="Button.lumine-secondary">
    <Setter Property="Background" Value="{DynamicResource Lumine.ControlSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource Lumine.Foreground}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.lumine-secondary:pointerover">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionHover}" />
  </Style>
  <Style Selector="Button.lumine-secondary:pressed">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionPressed}" />
  </Style>
  <Style Selector="Button.lumine-secondary:focus">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Lumine.Focus}" />
  </Style>
  <Style Selector="Button.lumine-secondary:disabled">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionDisabled}" />
    <Setter Property="Foreground" Value="{DynamicResource Lumine.MutedForeground}" />
  </Style>
  <Style Selector="Button.lumine-secondary.active">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionSelected}" />
    <Setter Property="Foreground" Value="{DynamicResource Lumine.Foreground}" />
  </Style>
  <Style Selector="Button.lumine-secondary.active:pointerover">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionSelectedHover}" />
  </Style>

  <Style Selector="Button.lumine-tertiary">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Lumine.Foreground}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.lumine-tertiary:pointerover">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionHover}" />
  </Style>
  <Style Selector="Button.lumine-tertiary:pressed">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionPressed}" />
  </Style>
  <Style Selector="Button.lumine-tertiary:focus">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Lumine.Focus}" />
  </Style>

  <Style Selector="Button.lumine-danger">
    <Setter Property="Background" Value="{DynamicResource Lumine.DangerTint}" />
    <Setter Property="Foreground" Value="{DynamicResource Lumine.Danger}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.lumine-danger:pointerover">
    <Setter Property="Background" Value="{DynamicResource Lumine.Danger}" />
    <Setter Property="Foreground" Value="{DynamicResource Lumine.PrimaryForeground}" />
  </Style>
  <Style Selector="Button.lumine-danger:pressed">
    <Setter Property="Background" Value="{DynamicResource Lumine.DangerPressed}" />
    <Setter Property="Foreground" Value="{DynamicResource Lumine.Foreground}" />
  </Style>

  <Style Selector="Button.lumine-icon">
    <Setter Property="Width" Value="{DynamicResource Lumine.ControlHeight}" />
    <Setter Property="Height" Value="{DynamicResource Lumine.ControlHeight}" />
    <Setter Property="MinWidth" Value="{DynamicResource Lumine.ControlHeight}" />
    <Setter Property="MinHeight" Value="{DynamicResource Lumine.ControlHeight}" />
    <Setter Property="Padding" Value="{DynamicResource Lumine.IconPadding}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.lumine-icon:pointerover">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionHover}" />
  </Style>
  <Style Selector="Button.lumine-icon:pressed">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionPressed}" />
  </Style>
  <Style Selector="Button.lumine-icon:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource Lumine.Focus}" />
  </Style>
  <Style Selector="Button.lumine-icon.lumine-primary">
    <Setter Property="Background" Value="{DynamicResource Lumine.Accent}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="TextBox.lumine-input">
    <Setter Property="MinHeight" Value="{DynamicResource Lumine.ControlHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource Lumine.BodyFontSize}" />
    <Setter Property="Background" Value="{DynamicResource Lumine.ControlSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource Lumine.Foreground}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Lumine.ControlRadius}" />
    <Setter Property="Padding" Value="{DynamicResource Lumine.InputPadding}" />
  </Style>
  <Style Selector="TextBox.lumine-input:pointerover">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionNeutral}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Lumine.Border}" />
  </Style>
  <Style Selector="TextBox.lumine-input:focus">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionNeutral}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Lumine.Focus}" />
  </Style>
  <Style Selector="TextBox.lumine-input:disabled">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionDisabled}" />
    <Setter Property="Foreground" Value="{DynamicResource Lumine.MutedForeground}" />
  </Style>

  <Style Selector="ComboBox.lumine-combo">
    <Setter Property="MinHeight" Value="{DynamicResource Lumine.ControlHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource Lumine.CaptionFontSize}" />
    <Setter Property="Background" Value="{DynamicResource Lumine.ControlSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource Lumine.Foreground}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Lumine.ControlRadius}" />
    <Setter Property="Padding" Value="{DynamicResource Lumine.ComboPadding}" />
  </Style>
  <Style Selector="ComboBox.lumine-combo:pointerover">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionNeutral}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Lumine.Border}" />
  </Style>
  <Style Selector="ComboBox.lumine-combo:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource Lumine.Focus}" />
  </Style>

  <Style Selector="CheckBox.lumine-check">
    <Setter Property="FontSize" Value="{DynamicResource Lumine.CaptionFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource Lumine.Foreground}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.lumine-segment">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="FontSize" Value="{DynamicResource Lumine.CaptionFontSize}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Lumine.MutedForeground}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.lumine-segment:pointerover">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Lumine.Foreground}" />
  </Style>
  <Style Selector="Button.lumine-segment.selected">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionSelected}" />
    <Setter Property="Foreground" Value="{DynamicResource Lumine.Foreground}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.lumine-segment.selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionSelectedHover}" />
  </Style>
  <Style Selector="Button.lumine-segment:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource Lumine.Focus}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.lumine-segment.icon-only">
    <Setter Property="Width" Value="36" />
    <Setter Property="MinWidth" Value="36" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="6" />
  </Style>

  <Style Selector="Border.lumine-segmented-host">
    <Setter Property="Background" Value="{DynamicResource Lumine.ControlSurface}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="2" />
  </Style>

  <Style Selector="Border.lumine-settings-group">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionNeutral}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14" />
  </Style>

  <Style Selector="Border.lumine-settings-notice">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionNeutral}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Lumine.Warning}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <Style Selector="Border.lumine-settings-divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Lumine.Border}" />
    <Setter Property="Margin" Value="0,4" />
  </Style>

  <Style Selector="Button.lumine-chip">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="FontSize" Value="{DynamicResource Lumine.CaptionFontSize}" />
    <Setter Property="Background" Value="{DynamicResource Lumine.AccentMuted}" />
    <Setter Property="Foreground" Value="{DynamicResource Lumine.Foreground}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>
  <Style Selector="Button.lumine-chip:pointerover">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionSelectedHover}" />
  </Style>
  <Style Selector="Button.lumine-chip-clear">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="FontSize" Value="{DynamicResource Lumine.CaptionFontSize}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Lumine.MutedForeground}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>
  <Style Selector="Button.lumine-chip-clear:pointerover">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Lumine.Foreground}" />
  </Style>
  <Style Selector="Button.lumine-chip-clear:pressed">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionPressed}" />
  </Style>
  <Style Selector="Button.lumine-chip-clear:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource Lumine.Focus}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Button.lumine-chip:pressed">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionPressed}" />
  </Style>
  <Style Selector="Button.lumine-chip:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource Lumine.Focus}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Slider.lumine-slider">
    <Setter Property="Foreground" Value="{DynamicResource Lumine.Focus}" />
    <Setter Property="Background" Value="{DynamicResource Lumine.ControlSurface}" />
  </Style>

  <Style Selector="Button.lumine-compact">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="FontSize" Value="{DynamicResource Lumine.CaptionFontSize}" />
  </Style>

  <Style Selector="Button.lumine-tag-swatch">
    <Setter Property="Width" Value="{DynamicResource Lumine.TagSwatchSize}" />
    <Setter Property="Height" Value="{DynamicResource Lumine.TagSwatchSize}" />
    <Setter Property="MinWidth" Value="{DynamicResource Lumine.TagSwatchSize}" />
    <Setter Property="MinHeight" Value="{DynamicResource Lumine.TagSwatchSize}" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="99" />
  </Style>
  <Style Selector="Border.lumine-tag-swatch-dot">
    <Setter Property="Width" Value="{DynamicResource Lumine.TagSwatchDotSize}" />
    <Setter Property="Height" Value="{DynamicResource Lumine.TagSwatchDotSize}" />
    <Setter Property="CornerRadius" Value="99" />
  </Style>

  <Style Selector="Border.lumine-tag-preview">
    <Setter Property="Width" Value="{DynamicResource Lumine.TagSwatchSize}" />
    <Setter Property="Height" Value="{DynamicResource Lumine.TagSwatchSize}" />
    <Setter Property="MinWidth" Value="{DynamicResource Lumine.TagSwatchSize}" />
    <Setter Property="MinHeight" Value="{DynamicResource Lumine.TagSwatchSize}" />
    <Setter Property="CornerRadius" Value="99" />
    <Setter Property="BorderBrush" Value="{DynamicResource Lumine.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.lumine-tag-preview.invalid">
    <Setter Property="BorderBrush" Value="{DynamicResource Lumine.Danger}" />
  </Style>

  <Style Selector="Button.lumine-tag-swatch:pointerover">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionHover}" />
  </Style>
  <Style Selector="Button.lumine-tag-swatch.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource Lumine.Focus}" />
  </Style>
  <Style Selector="Button.lumine-tag-swatch:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource Lumine.Focus}" />
  </Style>

  <Style Selector="Border.lumine-tag-advanced">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionNeutral}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10" />
  </Style>

  <Style Selector="Button.lumine-tag-row">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="9" />
  </Style>
  <Style Selector="Button.lumine-tag-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionHover}" />
  </Style>
  <Style Selector="Button.lumine-tag-row.selected">
    <Setter Property="Background" Value="{DynamicResource Lumine.AccentMuted}" />
  </Style>
  <Style Selector="Button.lumine-tag-row:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource Lumine.Focus}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.lumine-tag-row">
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="9" />
  </Style>
  <Style Selector="Border.lumine-tag-row.selected">
    <Setter Property="Background" Value="{DynamicResource Lumine.AccentMuted}" />
  </Style>

  <Style Selector="Border.lumine-popover">
    <Setter Property="Background" Value="{DynamicResource Lumine.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <Style Selector="Window.lumine-dialog-window">
    <Setter Property="Background" Value="{DynamicResource Lumine.Background}" />
    <Setter Property="Foreground" Value="{DynamicResource Lumine.Foreground}" />
    <Setter Property="FontFamily" Value="{DynamicResource Lumine.UiFont}" />
  </Style>

  <Style Selector="StackPanel.lumine-dialog-content">
    <Setter Property="Margin" Value="24" />
    <Setter Property="Spacing" Value="12" />
  </Style>

  <Style Selector="Border.lumine-dialog-symbol">
    <Setter Property="Width" Value="{DynamicResource Lumine.DialogSymbolSize}" />
    <Setter Property="Height" Value="{DynamicResource Lumine.DialogSymbolSize}" />
    <Setter Property="MinWidth" Value="{DynamicResource Lumine.DialogSymbolSize}" />
    <Setter Property="MinHeight" Value="{DynamicResource Lumine.DialogSymbolSize}" />
    <Setter Property="Background" Value="{DynamicResource Lumine.AccentMuted}" />
    <Setter Property="CornerRadius" Value="99" />
  </Style>
  <Style Selector="Border.lumine-dialog-symbol.danger">
    <Setter Property="Background" Value="{DynamicResource Lumine.DangerTint}" />
  </Style>

  <Style Selector="TextBlock.lumine-dialog-symbol-glyph">
    <Setter Property="Foreground" Value="{DynamicResource Lumine.Accent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="{DynamicResource Lumine.BodyFontSize}" />
  </Style>
  <Style Selector="TextBlock.lumine-dialog-symbol-glyph.danger">
    <Setter Property="Foreground" Value="{DynamicResource Lumine.Danger}" />
  </Style>

  <Style Selector="TextBlock.lumine-dialog-title">
    <Setter Property="Foreground" Value="{DynamicResource Lumine.Foreground}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="{DynamicResource Lumine.DialogTitleFontSize}" />
  </Style>

  <Style Selector="TextBlock.lumine-dialog-description">
    <Setter Property="Foreground" Value="{DynamicResource Lumine.MutedForeground}" />
    <Setter Property="FontSize" Value="{DynamicResource Lumine.BodyFontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource Lumine.BodyLineHeight}" />
  </Style>

  <Style Selector="Border.lumine-dialog-detail">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionNeutral}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="TextBlock.lumine-dialog-detail-text">
    <Setter Property="Foreground" Value="{DynamicResource Lumine.MutedForeground}" />
    <Setter Property="FontSize" Value="{DynamicResource Lumine.CaptionFontSize}" />
  </Style>

  <Style Selector="StackPanel.lumine-dialog-actions">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Spacing" Value="8" />
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>

  <Style Selector="Border.lumine-sidebar">
    <Setter Property="Background" Value="{DynamicResource Lumine.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Lumine.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Border.lumine-sidebar.docked">
    <Setter Property="Background" Value="{DynamicResource Lumine.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Lumine.Border}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="Border.lumine-sidebar.overlay">
    <Setter Property="Background" Value="{DynamicResource Lumine.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Lumine.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <Style Selector="Border.lumine-nav-rail">
    <Setter Property="Background" Value="{DynamicResource Lumine.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Lumine.Border}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <Style Selector="Border.lumine-nav-band">
    <Setter Property="Background" Value="{DynamicResource Lumine.Surface}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Border.lumine-nav-settings-band">
    <Setter Property="Background" Value="{DynamicResource Lumine.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Lumine.Border}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>

  <Style Selector="Button.lumine-icon.active">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionSelected}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.lumine-icon.active:pointerover">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionSelectedHover}" />
  </Style>

  <Style Selector="Button.lumine-nav-item">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Lumine.MutedForeground}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.lumine-nav-item:pointerover">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Lumine.Foreground}" />
  </Style>
  <Style Selector="Button.lumine-nav-item.selected">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionSelected}" />
    <Setter Property="Foreground" Value="{DynamicResource Lumine.Foreground}" />
  </Style>
  <Style Selector="Button.lumine-nav-item.selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionSelectedHover}" />
  </Style>
  <Style Selector="Button.lumine-nav-item:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource Lumine.Focus}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.lumine-nav-item.rail">
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.lumine-library-row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="2" />
  </Style>
  <!--
    Active Library is already identified by the explicit "表示中" label.
    Keep the row flat instead of turning a three-line metadata row into
    another card-like selected surface.
  -->
  <Style Selector="Border.lumine-library-row.selected">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.lumine-library-open">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Lumine.Foreground}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.lumine-library-open:pointerover">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionHover}" />
  </Style>
  <Style Selector="Button.lumine-library-open:pressed">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionPressed}" />
  </Style>
  <Style Selector="Button.lumine-library-open:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource Lumine.Focus}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.lumine-library-open:disabled">
    <Setter Property="Foreground" Value="{DynamicResource Lumine.MutedForeground}" />
  </Style>

  <Style Selector="Border.lumine-library-static">
    <Setter Property="Padding" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBox.lumine-flat-list">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="Button.lumine-folder-row">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Lumine.MutedForeground}" />
    <Setter Property="FontSize" Value="{DynamicResource Lumine.CaptionFontSize}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.lumine-folder-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Lumine.Foreground}" />
  </Style>
  <Style Selector="Button.lumine-folder-row.selected">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionSelected}" />
    <Setter Property="Foreground" Value="{DynamicResource Lumine.Foreground}" />
  </Style>
  <Style Selector="Button.lumine-folder-row.selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionSelectedHover}" />
  </Style>
  <Style Selector="Button.lumine-folder-row:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource Lumine.Focus}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="TextBlock.lumine-muted-caption">
    <Setter Property="Foreground" Value="{DynamicResource Lumine.MutedForeground}" />
    <Setter Property="FontSize" Value="{DynamicResource Lumine.CaptionFontSize}" />
  </Style>
  <Style Selector="TextBlock.lumine-body-caption">
    <Setter Property="Foreground" Value="{DynamicResource Lumine.Foreground}" />
    <Setter Property="FontSize" Value="{DynamicResource Lumine.CaptionFontSize}" />
  </Style>
  <Style Selector="TextBlock.lumine-accent-caption">
    <Setter Property="Foreground" Value="{DynamicResource Lumine.Accent}" />
    <Setter Property="FontSize" Value="{DynamicResource Lumine.CaptionFontSize}" />
  </Style>
  <Style Selector="TextBlock.lumine-warning-caption">
    <Setter Property="Foreground" Value="{DynamicResource Lumine.Warning}" />
    <Setter Property="FontSize" Value="{DynamicResource Lumine.CaptionFontSize}" />
  </Style>
  <Style Selector="TextBlock.lumine-section-title">
    <Setter Property="Foreground" Value="{DynamicResource Lumine.Foreground}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="{DynamicResource Lumine.BodyFontSize}" />
  </Style>

  <Style Selector="TextBlock.lumine-empty-message">
    <Setter Property="Foreground" Value="{DynamicResource Lumine.MutedForeground}" />
    <Setter Property="FontSize" Value="{DynamicResource Lumine.CaptionFontSize}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="Margin" Value="12" />
  </Style>
  <Style Selector="StackPanel.lumine-compact-stack">
    <Setter Property="Spacing" Value="4" />
  </Style>
  <Style Selector="TextBlock.lumine-nav-hint">
    <Setter Property="Foreground" Value="{DynamicResource Lumine.MutedForeground}" />
    <Setter Property="FontSize" Value="{DynamicResource Lumine.CaptionFontSize}" />
    <Setter Property="Margin" Value="2,4" />
  </Style>
  <Style Selector="StackPanel.lumine-nav-placeholder">
    <Setter Property="Spacing" Value="8" />
    <Setter Property="Margin" Value="2,8" />
  </Style>
  <Style Selector="TextBlock.lumine-nav-placeholder-title">
    <Setter Property="Foreground" Value="{DynamicResource Lumine.Foreground}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="{DynamicResource Lumine.BodyFontSize}" />
  </Style>

  <Style Selector="StackPanel.lumine-publication-row-content">
    <Setter Property="Spacing" Value="5" />
  </Style>
  <Style Selector="Border.lumine-publication-row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style Selector="StackPanel.lumine-publication-detail-body">
    <Setter Property="Spacing" Value="6" />
    <Setter Property="Margin" Value="0,6,0,0" />
  </Style>
  <Style Selector="Border.lumine-publication-detail">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionNeutral}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10" />
  </Style>
  <Style Selector="Grid.lumine-inline-actions">
    <Setter Property="ColumnSpacing" Value="6" />
  </Style>
  <Style Selector="StackPanel.lumine-publication-form">
    <Setter Property="Width" Value="330" />
    <Setter Property="Spacing" Value="8" />
    <Setter Property="Margin" Value="12" />
  </Style>
  <Style Selector="Border.lumine-divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Lumine.Border}" />
    <Setter Property="Margin" Value="0,6" />
  </Style>

  <Style Selector="Border.lumine-status-hud">
    <Setter Property="Background" Value="{DynamicResource Lumine.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,6" />
  </Style>

  <Style Selector="Border.lumine-command-bar">
    <Setter Property="Background" Value="{DynamicResource Lumine.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Lumine.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <Style Selector="Border.lumine-card">
    <Setter Property="Background" Value="{DynamicResource Lumine.InteractionNeutral}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Lumine.PanelRadius}" />
    <Setter Property="Padding" Value="{DynamicResource Lumine.CardPadding}" />
  </Style>

</Styles>
